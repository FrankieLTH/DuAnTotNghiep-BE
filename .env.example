# Docker Compose configuration. Copy this file to .env in the repository root.
# Keep real credentials in .env; never commit them.
# Required: use a long random JWT secret and real SMTP credentials.
JWT_SECRET=
DUANMOI_SMTP_USER=
DUANMOI_SMTP_PASS=

DUANMOI_FRONTEND_URL=http://localhost:5174
DUANMOI_SMTP_HOST=smtp.gmail.com
DUANMOI_SMTP_PORT=587
DUANMOI_SMTP_SECURE=false
DUANMOI_SMTP_FROM="Đồi Bông Gòn <no-reply@duanmoi.local>"

# Optional until PayOS or TTLock is used.
DUANMOI_PAYOS_CLIENT_ID=
DUANMOI_PAYOS_API_KEY=
DUANMOI_PAYOS_CHECKSUM_KEY=
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_CALLBACK_PATH=/api/webhooks/ttlock/callback
