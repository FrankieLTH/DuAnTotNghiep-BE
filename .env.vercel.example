# Reference for Vercel Project Settings > Environment Variables.
# Do not copy this over the Docker .env. Use separate databases for Preview.
# VERCEL and VERCEL_ENV are supplied by Vercel automatically.
NODE_ENV=production
TZ=Asia/Ho_Chi_Minh
VITE_API_URL=/api
FRONTEND_URL=https://your-project.vercel.app

# External MySQL 8. Existing SQL uses mixed-case names: lower_case_table_names=1.
DB_HOST=
DB_PORT=3306
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=duanmoi
DB_SSL=true
# Optional PEM CA certificate; escaped \n is accepted.
DB_SSL_CA=
DB_POOL_SIZE=5

# Use the Redis TCP/TLS URL, not an HTTP REST URL.
REDIS_URL=rediss://default:password@your-redis-host:6379
# Leave unset to use duanmoi:production or duanmoi:preview automatically.
# REDIS_KEY_PREFIX=
JWT_SECRET=
CRON_SECRET=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Đồi Bông Gòn <your-smtp-email@gmail.com>"

PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
TTLOCK_CLIENT_ID=
TTLOCK_CLIENT_SECRET=
TTLOCK_CALLBACK_PATH=/api/webhooks/ttlock/callback
