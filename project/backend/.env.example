# App Configuration
PORT=3000

# Database Configuration (local Docker MySQL)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USERNAME=duanmoi
DB_PASSWORD=your_local_database_password
DB_DATABASE=duanmoi

# Redis Configuration (BullMQ & Cache)
REDIS_URL=redis://localhost:6380

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_secret

# TTLock Smart Lock Integration
TTLOCK_CLIENT_ID=your_ttlock_client_id
TTLOCK_CLIENT_SECRET=your_ttlock_client_secret
TTLOCK_CALLBACK_PATH=/webhooks/ttlock/callback

# PayOS Payment Gateway Integration
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# SMTP Mailer Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_FROM="Homestay Automation" <no-reply@homestay.com>
